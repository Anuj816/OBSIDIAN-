<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Soft Apex Bloom Glow at Top Obsidian Tip (Only at apex, subtle) -->
    <path
        android:pathData="M54,24m-16,0a16,16 0 1,1 32,0a16,16 0 1,1 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="24"
                android:gradientRadius="16"
                android:startColor="#6600E5FF"
                android:endColor="#0000E5FF"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- 2. Thin Gold Ring (Hi-Fi Studio Accent centered on crystal waist) -->
    <path
        android:strokeWidth="1.5"
        android:strokeColor="#D4AF37"
        android:fillColor="#00000000"
        android:pathData="M35,54 A19,19 0 1,0 73,54 A19,19 0 1,0 35,54" />

    <!-- 4 Tiny Precision Gold Ticks on the Ring (Compass points) -->
    <path
        android:strokeWidth="1.3"
        android:strokeColor="#F5D77F"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,32.5 L54,36 M54,72 L54,75.5 M32.5,54 L36,54 M72,54 L75.5,54" />

    <!-- 3. Main Mark: Cyan Obsidian Crystal (Vertical Faceted Spear / Diamond) -->
