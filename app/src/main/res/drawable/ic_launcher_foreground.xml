    <path
        android:pathData="M54,24 L43,54 L54,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="315"
                android:startColor="#80DEEA"
                android:centerColor="#00B8D4"
                android:endColor="#00838F"
