        </aapt:attr>
    </path>

    <!-- Upper Right Facet (Primary Light Highlight) -->
    <path
        android:pathData="M54,24 L54,54 L65,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="225"
                android:startColor="#E0F7FA"
                android:centerColor="#00E5FF"
                android:endColor="#00B8D4"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Lower Left Facet (Deep Refraction) -->
    <path
        android:pathData="M43,54 L54,82 L54,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="45"
                android:startColor="#0097A7"
                android:centerColor="#006064"
                android:endColor="#004D40"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Lower Right Facet (Electric Cyan Gradient) -->
    <path
        android:pathData="M54,54 L54,82 L65,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:startColor="#00E5FF"
                android:centerColor="#0097A7"
                android:endColor="#006064"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Outer Facet Contour Edge -->
    <path
        android:strokeWidth="0.8"
        android:strokeColor="#80DEEA"
        android:fillColor="#00000000"
        android:pathData="M54,24 L65,54 L54,82 L43,54 Z" />

    <!-- Equatorial Facet Ridge -->
    <path
        android:strokeWidth="0.6"
        android:strokeColor="#B2EBF2"
        android:fillColor="#00000000"
        android:pathData="M43,54 L65,54" />

    <!-- Vertical Center Spine Highlight (Sharp crystal ridge) -->
    <path
        android:strokeWidth="0.9"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,24 L54,82" />

    <!-- 4. Top Apex Glint / Obsidian Peak Flare (Subtle Diamond Sparkle) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,21.5 L55.5,24 L54,26.5 L52.5,24 Z" />
    <path
        android:strokeWidth="0.5"
