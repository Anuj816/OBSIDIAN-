<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:background="#13161F">
    
    <!-- Right Album Artwork -->
    <ImageView
        android:id="@+id/notification_album_art"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background" />

    <!-- Left Content Column -->
    <LinearLayout
        android:id="@+id/notification_content_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/notification_album_art"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">
        
        <!-- Header: App / Mode + Queue Position -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            
            <ImageView
                android:id="@+id/notification_header_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_notification_obsidian" />
                
            <TextView
                android:id="@+id/notification_header_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Obsidian • 1/490"
                android:textColor="#00E5FF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
        
        <!-- Track Title -->
        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Maahi"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
            
        <!-- Artist & Album Subtitle -->
        <TextView
            android:id="@+id/notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Sharib Toshi &amp; Toshi Sabri • Raaz"
            android:textColor="#9EABB8"
            android:textSize="13sp" />
            
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Media Controls Row: Prev, Play/Pause, Next, Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            
            <ImageButton
                android:id="@+id/notification_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notif_prev" />
                
            <ImageButton
                android:id="@+id/notification_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notif_pause" />
                
            <ImageButton
                android:id="@+id/notification_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notif_next" />
                
            <ImageButton
                android:id="@+id/notification_btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_notif_close" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
